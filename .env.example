# Bhu-Drishti 3D Environment Configuration

PROJECT_NAME=Bhu-Drishti 3D
ENVIRONMENT=development
# Left empty on purpose. This template used to ship the literal development key
# `bhu_drishti_3d_super_secret_jwt_key_airoli_2026_cadastre`, which handed the
# JWT signing secret to everyone who copied the file. Generate your own:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The app does fail closed on the known defaults -- app/core/config.py raises
# RuntimeError in production mode if SECRET_KEY is one of them, so a deployment
# that copied this key refuses to boot rather than issuing forgeable tokens.
# The value is still left blank so the safe path is the obvious one.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + PostGIS)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bhudrishti
POSTGRES_PASSWORD=bhudrishti_secure_spatial_2026
POSTGRES_DB=bhudrishti_3d
DATABASE_URL=postgresql+asyncpg://bhudrishti:bhudrishti_secure_spatial_2026@postgres:5432/bhudrishti_3d
SYNC_DATABASE_URL=postgresql://bhudrishti:bhudrishti_secure_spatial_2026@postgres:5432/bhudrishti_3d

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# MinIO (S3-compatible spatial asset storage)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_spatial
MINIO_BUCKET_NAME=bhudrishti-assets
MINIO_USE_SSL=false

# Digital Signature (Ed25519)
# Intentionally empty. A private key in a committed file is published, and the
# pair that used to live here was in every clone, so anyone could forge a
# signature this deployment would accept. Generate a pair for your deployment:
#   python -c "from cryptography.hazmat.primitives.asymmetric import ed25519 as e; k=e.Ed25519PrivateKey.generate(); print('ED25519_PRIVATE_KEY_HEX='+k.private_bytes_raw().hex()); print('ED25519_PUBLIC_KEY_HEX='+k.public_key().public_bytes_raw().hex())"
# Leave both unset only when ENABLE_DEMO_MODE=1, which signs with a key that is
# published on purpose and proves nothing about who signed anything.
ED25519_PRIVATE_KEY_HEX=
ED25519_PUBLIC_KEY_HEX=

# AI & Geometric Baselines
# NOTE: generated demonstration geometry is OFF unless ENABLE_DEMO_MODE is set.
# Leave it unset in any deployment that must only serve real data.
ENABLE_DEMO_MODE=

# Area data providers, in priority order. Government publications first, then
# the satellite-derived GlobalML release, then community OpenStreetMap.
# Dormant providers (missing endpoint/key) are skipped automatically.
OPENDATA_SOURCES=bhuvan,data.gov.in,globalml,openstreetmap

# Optional. Areas to fetch once at start-up so the first request for them is
# served from cache instead of waiting on a provider. Semicolon-separated
# lat,lon[,radius[,max_buildings]] entries, e.g.:
# OPENDATA_PREWARM_AREAS=19.1540,72.9965,500;12.9716,77.5946,800
# Prewarming changes only when the fetch happens, not what is served: it pulls
# the same providers through the same cache, and an area that cannot be fetched
# is still reported as un-fetchable on the request path.
# OPENDATA_PREWARM_AREAS=

# ISRO/NRSA Bhuvan vector (WFS). Both are required; the layer must be public.
# BHUVAN_WFS_URL=https://bhuvan-ows.nrsc.gov.in/bhuvan/ows
# BHUVAN_WFS_LAYER=public:layername
# BHUVAN_WFS_NAMESPACE=public
# BHUVAN_DATASET_NAME=Bhuvan building footprints

# Government of India open data (data.gov.in). Needs a registered API key and a
# resource that publishes polygon geometry, not a point-only or tabular list.
# OGD_API_KEY=
# OGD_RESOURCE_ID=
# OGD_DATASET_NAME=

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
